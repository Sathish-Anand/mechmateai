# Environment Configuration for Mechmate AI Backend

# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:19006

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mechmateai
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# OpenAI Configuration (for AI diagnosis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key_here

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration (for payments)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (for password resets, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,mp4,mov

# External APIs
# Car data API (example: NHTSA, CarQuery, etc.)
CAR_DATA_API_KEY=your_car_data_api_key

# Parts/Product APIs (for affiliate links)
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag
AUTO_PARTS_API_KEY=your_auto_parts_api_key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:19006,http://localhost:3000